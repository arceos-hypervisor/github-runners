# ------------------------------- 常用配置 -------------------------------
#
# 最小必填配置：
# - ORG
# - GH_PAT
#
# 仓库级 runner 额外填写：
# - REPO
#
# 其余配置都有默认值或自动生成规则，可按需覆盖。

# GitHub 所属者。所有需要访问 GitHub API 的命令都需要它。
# 组织级 runner：填写组织名。
# 仓库级 runner：填写拥有 REPO 的组织名或用户名。
# 是否必填：是。
# 默认值：空。
ORG=

# GitHub classic Personal Access Token。
# 所需权限：
# - 组织级 runner：admin:org
# - 仓库级 runner：目标仓库的 repo/admin 访问权限
# 真实 token 只应放在 .env 中，不要提交到仓库。
# 是否必填：是。
# 默认值：空。
GH_PAT=

# 可选的仓库名。
# 留空时管理组织级 runner：https://github.com/${ORG}
# 填写后管理仓库级 runner：https://github.com/${ORG}/${REPO}
# 是否必填：否；仅仓库级 runner 需要填写。
# 默认值：空。
REPO=

# 生成 docker compose 文件时使用的基础 runner 镜像。
# 如果当前目录存在 Dockerfile，且 RUNNER_IMAGE 保持官方默认值，
# runner.sh 在构建成功后可能会优先使用 RUNNER_CUSTOM_IMAGE。
# 是否必填：否。
# 默认值：ghcr.io/actions/actions-runner:latest
RUNNER_IMAGE=ghcr.io/actions/actions-runner:latest

# runner.sh 根据 Dockerfile 自动构建的本地自定义镜像 tag。
# 是否必填：否。
# 默认值：qc-actions-runner:v0.0.1
RUNNER_CUSTOM_IMAGE=qc-actions-runner:v0.0.1

# runner 容器名和 GitHub runner 名称前缀。
# 留空时会根据 hostname、ORG 和可选 REPO 自动生成。
# 如果手动设置且结尾不是 "-"，runner.sh 会自动追加 "-"。
# 是否必填：否。
# 默认值：
# - ORG 和 REPO 都为空：$(hostname)-
# - 仅 ORG 非空：$(hostname)-${ORG}-
# - ORG 和 REPO 都非空：$(hostname)-${ORG}-${REPO}-
RUNNER_NAME_PREFIX=

# GitHub Actions runner group 名称。
# 是否必填：否。
# 默认值：Default
RUNNER_GROUP=Default

# runner 容器内的工作目录。
# 留空时使用 GitHub runner 镜像的默认工作目录。
# 是否必填：否。
# 默认值：空。
RUNNER_WORKDIR=

# 普通 runner 的标签，逗号分隔。
# 这些 runner 由 "./runner.sh init -n N" 中的 N 控制数量。
# 是否必填：否。
# 默认值：intel
RUNNER_LABELS=intel

# 板子专用 runner 数量，会额外创建在普通 runner 之外。
# 是否必填：否。
# 默认值：2
RUNNER_BOARD_COUNT=2

# 板子专用 runner 的默认标签，逗号分隔。
# 是否必填：否。
# 默认值：board
BOARD_RUNNER_LABELS=board

# 板子专用 runner 的默认设备映射，逗号分隔。
# 每一项可以写成 "/宿主机设备" 或 "/宿主机设备:/容器内设备"。
# 是否必填：否。
# 默认值：/dev/loop-control,/dev/loop0,/dev/loop1,/dev/loop2,/dev/loop3,/dev/kvm
BOARD_RUNNER_DEVICES=/dev/loop-control,/dev/loop0,/dev/loop1,/dev/loop2,/dev/loop3,/dev/kvm

# 板子专用 runner 额外加入的 Linux 组，逗号分隔。
# /dev/kvm 的数字 GID 会由脚本单独检测并加入。
# 是否必填：否。
# 默认值：dialout
BOARD_RUNNER_GROUP_ADD=dialout

# 板子专用 runner 的额外挂载，分号分隔。
# 示例：/opt/cache:/opt/cache;/data/sdk:/data/sdk:ro
# 是否必填：否。
# 默认值：空。
BOARD_RUNNER_VOLUMES=

# 板子专用 runner 的额外环境变量，分号分隔。
# 示例：SDK_ROOT=/opt/sdk;BOARD_PORT=/dev/ttyUSB0
# 是否必填：否。
# 默认值：空。
BOARD_RUNNER_ENV=

# 板子专用 runner 启动时执行的命令。
# 是否必填：否。
# 默认值：/home/runner/run.sh
BOARD_RUNNER_COMMAND=/home/runner/run.sh

# 是否禁用 GitHub runner 自动更新。
# 在生成 compose 时会原样写入环境变量。
# 在手动注册逻辑中，只有值为 "1" 时才会追加 --disableupdate。
# 是否必填：否。
# 默认值：false
DISABLE_AUTO_UPDATE=false

# 代理变量。设置后会写入生成的 runner compose 环境变量。
# 是否必填：否。
# 默认值：空。
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=

# ------------------------------- 按板子覆盖配置 -------------------------------

# 单个板子 runner 的覆盖配置。
# 将 "1" 替换为板子编号；未设置的项会回退到对应的 BOARD_RUNNER_* 默认值。
# BOARD_RUNNER_LABELS_1=board,board-1
# BOARD_RUNNER_DEVICES_1=/dev/ttyUSB0:/dev/ttyUSB0,/dev/kvm
# BOARD_RUNNER_GROUP_ADD_1=dialout
# BOARD_RUNNER_VOLUMES_1=/opt/board-1:/opt/board
# BOARD_RUNNER_ENV_1=BOARD_ID=1;SERIAL_PORT=/dev/ttyUSB0
# BOARD_RUNNER_COMMAND_1=/home/runner/run.sh

# ------------------------------- 高级覆盖配置 -------------------------------

# 可选的 runner 注册 token。
# 通常不需要设置；runner.sh 会使用 GH_PAT 自动申请并缓存新的注册 token。
# 只有当你已经从 GitHub 获取了短期注册 token 时才需要临时覆盖。
# 是否必填：否。
# 默认值：空。
REG_TOKEN=

# 生成的 docker compose 文件路径。
# 留空时自动生成：
# - 仓库级：docker-compose.${ORG}.${REPO}.yml
# - 组织级：docker-compose.${ORG}.yml
# - ORG 为空：docker-compose.yml
# 是否必填：否。
# 默认值：空，表示使用上述自动生成规则。
COMPOSE_FILE=

# Dockerfile hash 缓存文件路径。
# 留空时会根据 ORG 和可选 REPO 自动生成，避免多组织/多仓库冲突。
# 自动生成规则：
# - 仓库级：.dockerfile.${ORG}.${REPO}.sha256
# - 组织级：.dockerfile.${ORG}.sha256
# - ORG 为空：.dockerfile.sha256
# 是否必填：否。
# 默认值：空，表示使用上述自动生成规则。
DOCKERFILE_HASH_FILE=

# 注册 token 缓存文件路径。
# 留空时会根据 ORG 和可选 REPO 自动生成，避免多组织/多仓库冲突。
# 自动生成规则：
# - 仓库级：.reg_token.cache.${ORG}.${REPO}
# - 组织级：.reg_token.cache.${ORG}
# - ORG 为空：.reg_token.cache
# 是否必填：否。
# 默认值：空，表示使用上述自动生成规则。
REG_TOKEN_CACHE_FILE=

# 注册 token 缓存有效期，单位秒。
# 是否必填：否。
# 默认值：300
REG_TOKEN_CACHE_TTL=300

# /dev/kvm 访问所需的数字组 ID。
# 留空时从宿主机 /dev/kvm 自动检测；检测失败时回退到 993。
# 是否必填：否。
# 默认值：空。
RUNNER_KVM_GID=
